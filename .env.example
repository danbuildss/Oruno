# Copy to .env and fill in. Never commit .env.

# development | test | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Postgres connection string
DATABASE_URL=postgres://oruno:oruno@127.0.0.1:5432/oruno_dev

# GitHub sign-in (a GitHub OAuth App). Leave all three unset to disable sign-in.
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://127.0.0.1:3000/v1/auth/github/callback

# Used only by the test suite (its database is wiped on every run)
TEST_DATABASE_URL=postgres://oruno:oruno@127.0.0.1:5432/oruno_test
